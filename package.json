{
  "name": "msfs-cat-ch",
  "version": "1.2.12",
  "private": true,
  "description": "MSFS_CAT_CH Microsoft Flight Simulator localization patch manager with GitHub-based updates",
  "author": "JCH2333",
  "license": "MIT",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCH2333/MSFS_CAT_CH.git"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "clean": "rimraf dist release",
    "dist": "npm run clean && npm run build && electron-builder",
    "dist:win": "npm run clean && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.0.1",
    "vite": "^8.0.8",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.jch2333.msfscatch",
    "productName": "MSFS_CAT_CH",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MSFS_CAT_CH"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JCH2333",
        "repo": "MSFS_CAT_CH"
      }
    ]
  }
}
